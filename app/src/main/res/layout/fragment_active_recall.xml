<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto" android:layout_width="match_parent" android:layout_height="match_parent" android:background="@color/bg" android:fillViewport="true">
 <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="16dp">
  <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="🧠 主动回忆" android:textColor="@color/text_primary" android:textSize="25sp" android:textStyle="bold"/>
  <TextView android:id="@+id/text_ar_stats" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="5dp" android:textColor="@color/text_secondary" android:textSize="12sp"/>
  <com.google.android.material.card.MaterialCardView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="14dp" app:cardBackgroundColor="@color/surface" app:cardCornerRadius="22dp" app:cardElevation="0dp" app:strokeColor="@color/line" app:strokeWidth="1dp">
   <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="20dp">
    <TextView android:id="@+id/text_ar_level" android:layout_width="match_parent" android:layout_height="wrap_content" android:textColor="@color/blue" android:textSize="12sp" android:textStyle="bold"/>
    <TextView android:id="@+id/text_ar_prompt" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="14dp" android:gravity="center" android:textColor="@color/text_primary" android:textSize="22sp" android:textStyle="bold"/>
    <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:gravity="center" android:text="不要看选项，先自己完整想出或写出意大利语。" android:textColor="@color/text_secondary" android:textSize="12sp"/>
    <EditText android:id="@+id/edit_ar_answer" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="18dp" android:background="@drawable/bg_search" android:hint="输入完整意大利语" android:minHeight="56dp" android:padding="12dp" android:textColor="@color/text_primary" android:textColorHint="@color/text_secondary"/>
    <com.google.android.material.button.MaterialButton android:id="@+id/button_ar_check" android:layout_width="match_parent" android:layout_height="50dp" android:layout_marginTop="10dp" android:text="检查回答" android:textAllCaps="false"/>
    <com.google.android.material.button.MaterialButton android:id="@+id/button_ar_reveal" style="@style/Widget.MaterialComponents.Button.OutlinedButton" android:layout_width="match_parent" android:layout_height="46dp" android:layout_marginTop="7dp" android:text="想不起来 · 显示答案" android:textAllCaps="false"/>
    <TextView android:id="@+id/text_ar_answer" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp" android:background="@drawable/bg_soft_panel" android:padding="12dp" android:textColor="@color/text_primary" android:textSize="17sp" android:textStyle="bold" android:visibility="gone"/>
    <TextView android:id="@+id/text_ar_feedback" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:textSize="12sp"/>
    <com.google.android.material.button.MaterialButton android:id="@+id/button_ar_audio" style="@style/Widget.MaterialComponents.Button.TextButton" android:layout_width="match_parent" android:layout_height="44dp" android:layout_marginTop="5dp" android:text="🔊 听正确答案" android:textAllCaps="false" android:visibility="gone"/>
    <com.google.android.material.button.MaterialButton android:id="@+id/button_ar_next" android:layout_width="match_parent" android:layout_height="48dp" android:layout_marginTop="8dp" android:text="下一句 →" android:textAllCaps="false" android:visibility="gone"/>
   </LinearLayout>
  </com.google.android.material.card.MaterialCardView>
 </LinearLayout>
</ScrollView>
