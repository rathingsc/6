<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto" android:layout_width="match_parent" android:layout_height="match_parent" android:background="@color/bg" android:fillViewport="true">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="16dp" android:paddingBottom="28dp">
        <com.google.android.material.button.MaterialButton android:id="@+id/button_speak5_back" style="@style/Widget.MaterialComponents.Button.TextButton" android:layout_width="wrap_content" android:layout_height="44dp" android:text="← 返回练习" android:textAllCaps="false" />
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="每日5句开口" android:textColor="@color/text_primary" android:textSize="27sp" android:textStyle="bold" />
        <TextView android:id="@+id/text_speak5_summary" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="5dp" android:textColor="@color/text_secondary" android:textSize="13sp" />
        <ProgressBar android:id="@+id/progress_speak5" style="?android:attr/progressBarStyleHorizontal" android:layout_width="match_parent" android:layout_height="7dp" android:layout_marginTop="12dp" android:max="100" />
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="10dp" android:orientation="horizontal">
            <TextView android:id="@+id/text_speak5_step" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:textColor="@color/text_primary" android:textSize="13sp" android:textStyle="bold" />
            <TextView android:id="@+id/text_speak5_level" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textColor="@color/blue" android:textSize="12sp" />
        </LinearLayout>
        <TextView android:id="@+id/text_speak5_theme" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="6dp" android:textColor="@color/text_secondary" android:textSize="12sp" />

        <com.google.android.material.card.MaterialCardView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="14dp" app:cardCornerRadius="20dp" app:cardElevation="0dp" app:strokeColor="@color/line" app:strokeWidth="1dp">
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="18dp">
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="只看中文，先自己说" android:textColor="@color/text_secondary" android:textSize="12sp" />
                <TextView android:id="@+id/text_speak5_prompt" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="10dp" android:lineSpacingExtra="5dp" android:textColor="@color/text_primary" android:textSize="24sp" android:textStyle="bold" />
                <TextView android:id="@+id/text_speak5_hint" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="10dp" android:background="@drawable/bg_soft_panel" android:padding="10dp" android:textColor="@color/text_secondary" android:textSize="12sp" android:visibility="gone" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <com.google.android.material.button.MaterialButton android:id="@+id/button_speak5_mic" android:layout_width="match_parent" android:layout_height="54dp" android:layout_marginTop="14dp" android:text="🎙 说出来" android:textAllCaps="false" />
        <EditText android:id="@+id/edit_speak5_answer" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="10dp" android:background="@drawable/bg_soft_panel" android:hint="语音识别不可用时，也可以输入意大利语" android:imeOptions="actionDone" android:inputType="textCapSentences|textMultiLine" android:minHeight="58dp" android:padding="12dp" android:textColor="@color/text_primary" android:textColorHint="@color/text_secondary" android:textSize="15sp" />
        <com.google.android.material.button.MaterialButton android:id="@+id/button_speak5_check" style="@style/Widget.MaterialComponents.Button.OutlinedButton" android:layout_width="match_parent" android:layout_height="48dp" android:layout_marginTop="8dp" android:text="检查输入" android:textAllCaps="false" />
        <com.google.android.material.button.MaterialButton android:id="@+id/button_speak5_hint" style="@style/Widget.MaterialComponents.Button.TextButton" android:layout_width="match_parent" android:layout_height="44dp" android:text="💡 给我一个提示" android:textAllCaps="false" android:textColor="@color/blue" />
        <com.google.android.material.button.MaterialButton android:id="@+id/button_speak5_reveal" style="@style/Widget.MaterialComponents.Button.TextButton" android:layout_width="match_parent" android:layout_height="46dp" android:text="不会 · 显示答案" android:textAllCaps="false" android:textColor="@color/text_secondary" />

        <TextView android:id="@+id/text_speak5_recognized" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="10dp" android:textColor="@color/text_secondary" android:textSize="13sp" android:visibility="gone" />
        <TextView android:id="@+id/text_speak5_answer" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:background="@drawable/bg_soft_panel" android:padding="14dp" android:lineSpacingExtra="4dp" android:textColor="@color/text_primary" android:textSize="18sp" android:textStyle="bold" android:visibility="gone" />
        <TextView android:id="@+id/text_speak5_feedback" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="10dp" android:lineSpacingExtra="3dp" android:textColor="@color/text_secondary" android:textSize="13sp" />

        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="10dp" android:orientation="horizontal">
            <com.google.android.material.button.MaterialButton android:id="@+id/button_speak5_play" style="@style/Widget.MaterialComponents.Button.OutlinedButton" android:layout_width="0dp" android:layout_height="48dp" android:layout_weight="1" android:text="🔊 正常" android:textAllCaps="false" android:visibility="gone" />
            <com.google.android.material.button.MaterialButton android:id="@+id/button_speak5_slow" style="@style/Widget.MaterialComponents.Button.OutlinedButton" android:layout_width="0dp" android:layout_height="48dp" android:layout_marginStart="8dp" android:layout_weight="1" android:text="🐢 慢速" android:textAllCaps="false" android:visibility="gone" />
        </LinearLayout>
        <com.google.android.material.button.MaterialButton android:id="@+id/button_speak5_next" android:layout_width="match_parent" android:layout_height="52dp" android:layout_marginTop="10dp" android:text="下一句 →" android:textAllCaps="false" android:visibility="gone" />
    </LinearLayout>
</ScrollView>
