<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto" android:layout_width="match_parent" android:layout_height="match_parent" android:background="@color/bg" android:fillViewport="true">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="16dp">
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_vertical">
            <com.google.android.material.button.MaterialButton android:id="@+id/button_shadow_back" style="@style/Widget.MaterialComponents.Button.TextButton" android:layout_width="wrap_content" android:layout_height="48dp" android:text="← 练习" />
            <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:gravity="center" android:text="Shadowing 三遍训练室" android:textColor="@color/text_primary" android:textSize="22sp" android:textStyle="bold" />
            <Space android:layout_width="68dp" android:layout_height="1dp" />
        </LinearLayout>
        <TextView android:id="@+id/text_shadow_stats" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="5dp" android:textColor="@color/text_secondary" android:textSize="12sp" />
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:text="目标：不是“跟得上”，而是离开字幕也能完整说出来。" android:textColor="@color/text_secondary" android:textSize="13sp" />

        <com.google.android.material.button.MaterialButtonToggleGroup android:id="@+id/group_shadow_speed" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp" app:selectionRequired="true" app:singleSelection="true">
            <com.google.android.material.button.MaterialButton android:id="@+id/button_speed_slow" style="@style/Widget.MaterialComponents.Button.OutlinedButton" android:layout_width="0dp" android:layout_height="48dp" android:layout_weight="1" android:text="0.70×" android:textSize="12sp" />
            <com.google.android.material.button.MaterialButton android:id="@+id/button_speed_mid" style="@style/Widget.MaterialComponents.Button.OutlinedButton" android:layout_width="0dp" android:layout_height="48dp" android:layout_weight="1" android:text="0.85×" android:textSize="12sp" />
            <com.google.android.material.button.MaterialButton android:id="@+id/button_speed_normal" style="@style/Widget.MaterialComponents.Button.OutlinedButton" android:layout_width="0dp" android:layout_height="48dp" android:layout_weight="1" android:text="1.00×" android:textSize="12sp" />
        </com.google.android.material.button.MaterialButtonToggleGroup>

        <com.google.android.material.card.MaterialCardView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp" app:cardBackgroundColor="@color/surface" app:cardCornerRadius="22dp" app:cardElevation="0dp" app:strokeColor="@color/line" app:strokeWidth="1dp">
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="20dp">
                <TextView android:id="@+id/text_shadow_stage" android:layout_width="match_parent" android:layout_height="wrap_content" android:textColor="@color/blue" android:textSize="15sp" android:textStyle="bold" />
                <TextView android:id="@+id/text_shadow_it" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="18dp" android:gravity="center" android:minHeight="84dp" android:textColor="@color/text_primary" android:textSize="24sp" android:textStyle="bold" />
                <TextView android:id="@+id/text_shadow_zh" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="10dp" android:gravity="center" android:minHeight="46dp" android:textColor="@color/text_secondary" android:textSize="15sp" />
                <TextView android:id="@+id/text_shadow_record_hint" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:background="@drawable/bg_soft_panel" android:padding="10dp" android:textColor="@color/text_secondary" android:textSize="13sp" />

                <com.google.android.material.button.MaterialButton android:id="@+id/button_shadow_stage" android:layout_width="match_parent" android:layout_height="52dp" android:layout_marginTop="12dp" android:text="🔊 播放标准句" android:textAllCaps="false" />
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:layout_marginTop="8dp">
                    <com.google.android.material.button.MaterialButton android:id="@+id/button_shadow_record" style="@style/Widget.MaterialComponents.Button.OutlinedButton" android:layout_width="0dp" android:layout_height="50dp" android:layout_weight="1" android:layout_marginEnd="4dp" android:text="● 录下自己" android:textAllCaps="false" />
                    <com.google.android.material.button.MaterialButton android:id="@+id/button_shadow_record_play" style="@style/Widget.MaterialComponents.Button.OutlinedButton" android:layout_width="0dp" android:layout_height="50dp" android:layout_weight="1" android:layout_marginStart="4dp" android:enabled="false" android:text="▶ 回放自己" android:textAllCaps="false" />
                </LinearLayout>
                <com.google.android.material.button.MaterialButton android:id="@+id/button_shadow_speech" style="@style/Widget.MaterialComponents.Button.OutlinedButton" android:layout_width="match_parent" android:layout_height="52dp" android:layout_marginTop="8dp" android:text="🎙 跟读并评分" android:textAllCaps="false" />
                <TextView android:id="@+id/text_shadow_result" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp" android:background="@drawable/bg_soft_panel" android:minHeight="72dp" android:padding="12dp" android:textColor="@color/text_secondary" android:textSize="13sp" android:lineSpacingExtra="2dp" />
                <com.google.android.material.button.MaterialButton android:id="@+id/button_shadow_next" android:layout_width="match_parent" android:layout_height="52dp" android:layout_marginTop="10dp" android:text="进入第2遍 →" android:textAllCaps="false" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>
    </LinearLayout>
</ScrollView>
