<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent" android:layout_height="match_parent" android:background="@color/bg" android:fillViewport="true">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="16dp" android:paddingBottom="30dp">
        <TextView android:id="@+id/text_memory_study_progress" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="第1步 / 5" android:textColor="@color/blue" android:textSize="12sp" android:textStyle="bold" />
        <ProgressBar android:id="@+id/progress_memory_study" style="?android:attr/progressBarStyleHorizontal" android:layout_width="match_parent" android:layout_height="8dp" android:layout_marginTop="7dp" android:max="100" android:progress="20" android:progressTint="@color/blue" android:progressBackgroundTint="@color/line" />
        <TextView android:id="@+id/text_memory_study_title" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp" android:textColor="@color/text_primary" android:textSize="23sp" android:textStyle="bold" />
        <TextView android:id="@+id/text_memory_study_mode" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="5dp" android:textColor="@color/text_secondary" android:textSize="13sp" />
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="10dp" android:orientation="horizontal">
            <com.google.android.material.button.MaterialButton android:id="@+id/button_memory_audio_normal" android:layout_width="0dp" android:layout_height="46dp" android:layout_weight="1" android:text="🔊 正常朗读" android:textAllCaps="false" />
            <com.google.android.material.button.MaterialButton android:id="@+id/button_memory_audio_slow" style="@style/Widget.MaterialComponents.Button.OutlinedButton" android:layout_width="0dp" android:layout_height="46dp" android:layout_marginStart="8dp" android:layout_weight="1" android:text="🐢 慢速朗读" android:textAllCaps="false" />
        </LinearLayout>
        <com.google.android.material.button.MaterialButton android:id="@+id/button_memory_toggle" style="@style/Widget.MaterialComponents.Button.OutlinedButton" android:layout_width="match_parent" android:layout_height="44dp" android:layout_marginTop="6dp" android:text="隐藏中文" android:textAllCaps="false" />
        <com.google.android.material.card.MaterialCardView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp" app:cardCornerRadius="20dp" app:cardElevation="0dp" app:strokeColor="@color/line" app:strokeWidth="1dp">
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="17dp">
                <TextView android:id="@+id/text_memory_italian" android:layout_width="match_parent" android:layout_height="wrap_content" android:textColor="@color/text_primary" android:textSize="19sp" android:lineSpacingExtra="7dp" />
                <TextView android:id="@+id/text_memory_chinese" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="14dp" android:background="@drawable/bg_soft_panel" android:padding="12dp" android:textColor="@color/text_secondary" android:textSize="14sp" android:lineSpacingExtra="4dp" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>
        <com.google.android.material.card.MaterialCardView android:id="@+id/card_memory_targets" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp" app:cardBackgroundColor="@color/surface_success" app:cardCornerRadius="16dp" app:cardElevation="0dp" app:strokeColor="@color/line" app:strokeWidth="1dp">
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="13dp">
                <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="本节40个目标词" android:textColor="@color/text_primary" android:textSize="14sp" android:textStyle="bold" />
                <TextView android:id="@+id/text_memory_targets" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="6dp" android:textColor="@color/text_secondary" android:textSize="12sp" android:lineSpacingExtra="3dp" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>
        <com.google.android.material.card.MaterialCardView android:id="@+id/card_memory_reinforcement" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp" android:visibility="gone" app:cardBackgroundColor="@color/bg" app:cardCornerRadius="16dp" app:cardElevation="0dp" app:strokeColor="@color/line" app:strokeWidth="1dp">
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="13dp">
                <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="🔁 旧词复现" android:textColor="@color/text_primary" android:textSize="14sp" android:textStyle="bold" />
                <TextView android:id="@+id/text_memory_reinforcement_stats" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="5dp" android:textColor="@color/text_secondary" android:textSize="12sp" android:lineSpacingExtra="2dp" />
                <TextView android:id="@+id/text_memory_reinforcement_it" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:textColor="@color/text_primary" android:textSize="14sp" android:lineSpacingExtra="3dp" />
                <TextView android:id="@+id/text_memory_reinforcement_zh" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="6dp" android:textColor="@color/text_secondary" android:textSize="12sp" android:lineSpacingExtra="2dp" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>
        <com.google.android.material.button.MaterialButton android:id="@+id/button_memory_reveal" style="@style/Widget.MaterialComponents.Button.OutlinedButton" android:layout_width="match_parent" android:layout_height="48dp" android:layout_marginTop="12dp" android:text="显示答案" android:textAllCaps="false" android:visibility="gone" />
        <com.google.android.material.button.MaterialButton android:id="@+id/button_memory_next" android:layout_width="match_parent" android:layout_height="54dp" android:layout_marginTop="10dp" android:text="下一步" android:textAllCaps="false" android:textSize="15sp" />
        <com.google.android.material.button.MaterialButton android:id="@+id/button_memory_section_review" style="@style/Widget.MaterialComponents.Button.OutlinedButton" android:layout_width="match_parent" android:layout_height="50dp" android:layout_marginTop="8dp" android:text="用智能背词复习本节40词" android:textAllCaps="false" android:visibility="gone" />
        <TextView android:id="@+id/text_memory_finish_hint" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="10dp" android:gravity="center" android:textColor="@color/text_secondary" android:textSize="12sp" android:visibility="gone" />
    </LinearLayout>
</androidx.core.widget.NestedScrollView>
