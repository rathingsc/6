<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/bg"
    android:paddingTop="10dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:paddingHorizontal="16dp">
        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical">
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="终学意语 · 课程词库"
                android:textColor="@color/text_primary"
                android:textSize="23sp"
                android:textStyle="bold" />
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="搜索和筛选都在后台完成；点单词卡再展开语法、FSRS与例句"
                android:textColor="@color/text_secondary"
                android:textSize="11sp" />
        </LinearLayout>
        <com.google.android.material.button.MaterialButton
            android:id="@+id/button_open_custom_library"
            style="@style/Widget.MaterialComponents.Button.TextButton"
            android:layout_width="wrap_content"
            android:layout_height="42dp"
            android:minWidth="0dp"
            android:text="⭐ 我的词句"
            android:textAllCaps="false"
            android:textColor="@color/blue"
            android:textSize="12sp" />
    </LinearLayout>

    <com.google.android.material.card.MaterialCardView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="14dp"
        android:layout_marginTop="10dp"
        app:cardBackgroundColor="@color/surface"
        app:cardCornerRadius="18dp"
        app:cardElevation="0dp"
        app:strokeColor="@color/line"
        app:strokeWidth="1dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="12dp">

            <EditText
                android:id="@+id/edit_search"
                android:layout_width="match_parent"
                android:layout_height="46dp"
                android:background="@drawable/bg_search"
                android:hint="🔎  搜索意大利语 / 中文 / 英文"
                android:textColorHint="@color/text_secondary"
                android:inputType="text"
                android:paddingHorizontal="13dp"
                android:singleLine="true"
                android:textColor="@color/text_primary"
                android:textCursorDrawable="@null"
                android:textSize="13sp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="8dp"
                    android:text="主题"
                    android:textColor="@color/text_secondary"
                    android:textSize="12sp"
                    android:textStyle="bold" />
                <Spinner
                    android:id="@+id/spinner_topic"
                    android:layout_width="0dp"
                    android:layout_height="44dp"
                    android:layout_weight="1"
                    android:background="@drawable/bg_search"
                    android:popupBackground="@color/surface" />
            </LinearLayout>

            <com.google.android.material.chip.ChipGroup
                android:id="@+id/group_vocab_filters"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                app:chipSpacingHorizontal="6dp"
                app:chipSpacingVertical="4dp"
                app:singleLine="false">
                <com.google.android.material.chip.Chip
                    android:id="@+id/check_route"
                    style="@style/Widget.MaterialComponents.Chip.Filter"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="🎯 当前路线"
                    android:textColor="@color/text_primary" />
                <com.google.android.material.chip.Chip
                    android:id="@+id/check_favorite"
                    style="@style/Widget.MaterialComponents.Chip.Filter"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="⭐ 收藏"
                    android:textColor="@color/text_primary" />
                <com.google.android.material.chip.Chip
                    android:id="@+id/check_low"
                    style="@style/Widget.MaterialComponents.Chip.Filter"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="未达4级"
                    android:textColor="@color/text_primary" />
                <com.google.android.material.chip.Chip
                    android:id="@+id/check_wrong"
                    style="@style/Widget.MaterialComponents.Chip.Filter"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="❌ 错词"
                    android:textColor="@color/text_primary" />
                <com.google.android.material.chip.Chip
                    android:id="@+id/check_stubborn"
                    style="@style/Widget.MaterialComponents.Chip.Filter"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="🔥 顽固词"
                    android:textColor="@color/text_primary" />
                <com.google.android.material.chip.Chip
                    android:id="@+id/check_graduated"
                    style="@style/Widget.MaterialComponents.Chip.Filter"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="🎓 已毕业"
                    android:textColor="@color/text_primary" />
            </com.google.android.material.chip.ChipGroup>
        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:paddingStart="18dp"
        android:paddingEnd="12dp"
        android:paddingTop="5dp"
        android:paddingBottom="2dp">
        <TextView
            android:id="@+id/text_count"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:textColor="@color/text_secondary"
            android:textSize="11sp" />
        <com.google.android.material.button.MaterialButton
            android:id="@+id/button_reset_vocab_filters"
            style="@style/Widget.MaterialComponents.Button.TextButton"
            android:layout_width="wrap_content"
            android:layout_height="36dp"
            android:minWidth="0dp"
            android:text="重置筛选"
            android:textAllCaps="false"
            android:textColor="@color/blue"
            android:textSize="11sp" />
    </LinearLayout>

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/recycler_vocabulary"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:clipToPadding="false"
        android:paddingBottom="16dp" />
</LinearLayout>
