<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto" android:layout_width="match_parent" android:layout_height="match_parent" android:background="@color/bg" android:fillViewport="true">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="16dp" android:paddingBottom="28dp">
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="练习" android:textColor="@color/text_primary" android:textSize="28sp" android:textStyle="bold" />
        <TextView android:id="@+id/text_practice_hint" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="5dp" android:text="主课程已经自动安排复习。这里只在你想额外练某一项时使用。" android:textColor="@color/text_secondary" android:textSize="13sp" />
        <com.google.android.material.card.MaterialCardView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="16dp" app:cardCornerRadius="20dp" app:cardElevation="0dp" app:strokeColor="@color/line" app:strokeWidth="1dp">
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="14dp">
                <com.google.android.material.button.MaterialButton android:id="@+id/button_simple_listen" style="@style/Widget.MaterialComponents.Button.OutlinedButton" android:layout_width="match_parent" android:layout_height="54dp" android:text="🎧 听力练习" android:textAllCaps="false" android:gravity="start|center_vertical" />
                <com.google.android.material.button.MaterialButton android:id="@+id/button_simple_pronunciation" style="@style/Widget.MaterialComponents.Button.OutlinedButton" android:layout_width="match_parent" android:layout_height="54dp" android:layout_marginTop="8dp" android:text="🗣 发音练习" android:textAllCaps="false" android:gravity="start|center_vertical" />
                <com.google.android.material.button.MaterialButton android:id="@+id/button_simple_wrong" style="@style/Widget.MaterialComponents.Button.OutlinedButton" android:layout_width="match_parent" android:layout_height="54dp" android:layout_marginTop="8dp" android:text="❤️ 错题复习" android:textAllCaps="false" android:gravity="start|center_vertical" />
                <com.google.android.material.button.MaterialButton android:id="@+id/button_simple_spelling" style="@style/Widget.MaterialComponents.Button.OutlinedButton" android:layout_width="match_parent" android:layout_height="54dp" android:layout_marginTop="8dp" android:text="✍️ 拼写练习" android:textAllCaps="false" android:gravity="start|center_vertical" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>
        <com.google.android.material.button.MaterialButton android:id="@+id/button_more_practice" style="@style/Widget.MaterialComponents.Button.TextButton" android:layout_width="match_parent" android:layout_height="50dp" android:layout_marginTop="8dp" android:text="更多练习工具 ▾" android:textAllCaps="false" android:textColor="@color/blue" />
        <LinearLayout android:id="@+id/container_advanced_practice" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:visibility="gone">
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:text="进阶工具" android:textColor="@color/text_primary" android:textSize="16sp" android:textStyle="bold" />
            <com.google.android.material.button.MaterialButton android:id="@+id/button_adv_reading" style="@style/Widget.MaterialComponents.Button.OutlinedButton" android:layout_width="match_parent" android:layout_height="50dp" android:layout_marginTop="8dp" android:text="📖 分级阅读" android:textAllCaps="false" />
            <com.google.android.material.button.MaterialButton android:id="@+id/button_adv_sentences" style="@style/Widget.MaterialComponents.Button.OutlinedButton" android:layout_width="match_parent" android:layout_height="50dp" android:layout_marginTop="7dp" android:text="💬 核心句子" android:textAllCaps="false" />
            <com.google.android.material.button.MaterialButton android:id="@+id/button_adv_grammar" style="@style/Widget.MaterialComponents.Button.OutlinedButton" android:layout_width="match_parent" android:layout_height="50dp" android:layout_marginTop="7dp" android:text="🧩 语法与句型" android:textAllCaps="false" />
            <com.google.android.material.button.MaterialButton android:id="@+id/button_adv_verbs" style="@style/Widget.MaterialComponents.Button.OutlinedButton" android:layout_width="match_parent" android:layout_height="50dp" android:layout_marginTop="7dp" android:text="🔤 动词变位" android:textAllCaps="false" />
            <com.google.android.material.button.MaterialButton android:id="@+id/button_adv_phrases" style="@style/Widget.MaterialComponents.Button.OutlinedButton" android:layout_width="match_parent" android:layout_height="50dp" android:layout_marginTop="7dp" android:text="💬 高频短语" android:textAllCaps="false" />
            <com.google.android.material.button.MaterialButton android:id="@+id/button_adv_scenarios" style="@style/Widget.MaterialComponents.Button.OutlinedButton" android:layout_width="match_parent" android:layout_height="50dp" android:layout_marginTop="7dp" android:text="🎭 生活场景" android:textAllCaps="false" />
            <com.google.android.material.button.MaterialButton android:id="@+id/button_adv_all" style="@style/Widget.MaterialComponents.Button.TextButton" android:layout_width="match_parent" android:layout_height="48dp" android:layout_marginTop="5dp" android:text="📊 弱项分析" android:textAllCaps="false" android:textColor="@color/text_secondary" />
        </LinearLayout>
    </LinearLayout>
</androidx.core.widget.NestedScrollView>
