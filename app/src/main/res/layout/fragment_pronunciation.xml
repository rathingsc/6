<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto" android:layout_width="match_parent" android:layout_height="match_parent" android:background="@color/bg" android:fillViewport="true">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="16dp">
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_vertical">
            <com.google.android.material.button.MaterialButton android:id="@+id/button_pron_back" style="@style/Widget.MaterialComponents.Button.TextButton" android:layout_width="wrap_content" android:layout_height="42dp" android:text="← 练习" />
            <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:gravity="center" android:text="意大利语发音专项" android:textColor="@color/text_primary" android:textSize="22sp" android:textStyle="bold" />
            <Space android:layout_width="68dp" android:layout_height="1dp" />
        </LinearLayout>
        <TextView android:id="@+id/text_pron_stats" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="5dp" android:textColor="@color/text_secondary" android:textSize="12sp" />
        <com.google.android.material.card.MaterialCardView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="14dp" app:cardBackgroundColor="@color/surface" app:cardCornerRadius="22dp" app:cardElevation="0dp" app:strokeColor="@color/line" app:strokeWidth="1dp">
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="20dp">
                <TextView android:id="@+id/text_pron_focus" android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center" android:textColor="@color/blue" android:textSize="17sp" android:textStyle="bold" />
                <TextView android:id="@+id/text_pron_note" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="10dp" android:gravity="center" android:textColor="@color/text_secondary" android:textSize="13sp" android:lineSpacingExtra="2dp" />
                <com.google.android.material.button.MaterialButton android:id="@+id/button_pron_replay" android:layout_width="match_parent" android:layout_height="52dp" android:layout_marginTop="14dp" android:text="🔊 播放目标读音" android:textAllCaps="false" />
                <com.google.android.material.button.MaterialButton android:id="@+id/button_pron_a" style="@style/Widget.MaterialComponents.Button.OutlinedButton" android:layout_width="match_parent" android:layout_height="54dp" android:layout_marginTop="12dp" android:textAllCaps="false" android:textSize="18sp" />
                <com.google.android.material.button.MaterialButton android:id="@+id/button_pron_b" style="@style/Widget.MaterialComponents.Button.OutlinedButton" android:layout_width="match_parent" android:layout_height="54dp" android:layout_marginTop="8dp" android:textAllCaps="false" android:textSize="18sp" />
                <TextView android:id="@+id/text_pron_result" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp" android:background="@drawable/bg_soft_panel" android:padding="12dp" android:textSize="13sp" android:lineSpacingExtra="2dp" />
                <com.google.android.material.button.MaterialButton android:id="@+id/button_pron_speak" style="@style/Widget.MaterialComponents.Button.OutlinedButton" android:layout_width="match_parent" android:layout_height="48dp" android:layout_marginTop="10dp" android:text="🎙 跟读目标词" android:textAllCaps="false" android:visibility="gone" />
                <com.google.android.material.button.MaterialButton android:id="@+id/button_pron_next" android:layout_width="match_parent" android:layout_height="48dp" android:layout_marginTop="8dp" android:text="下一组 →" android:textAllCaps="false" android:visibility="gone" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>
    </LinearLayout>
</ScrollView>
