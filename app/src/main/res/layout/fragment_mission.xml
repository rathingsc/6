<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/bg"
    android:padding="16dp">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_vertical" android:orientation="horizontal">
        <com.google.android.material.button.MaterialButton android:id="@+id/button_mission_back" style="@style/Widget.MaterialComponents.Button.TextButton" android:layout_width="wrap_content" android:layout_height="42dp" android:text="← 返回" android:textAllCaps="false" />
        <TextView android:id="@+id/text_mission_title" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:gravity="center" android:text="场景任务" android:textColor="@color/text_primary" android:textSize="20sp" android:textStyle="bold" />
        <Space android:layout_width="64dp" android:layout_height="1dp" />
    </LinearLayout>
    <ProgressBar android:id="@+id/progress_mission" style="?android:attr/progressBarStyleHorizontal" android:layout_width="match_parent" android:layout_height="7dp" android:layout_marginTop="8dp" android:max="100" android:progressTint="@color/green" />
    <TextView android:id="@+id/text_mission_status" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:gravity="center" android:textColor="@color/text_secondary" android:textSize="11sp" />
    <com.google.android.material.card.MaterialCardView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="16dp" app:cardBackgroundColor="@color/surface" app:cardCornerRadius="20dp" app:cardElevation="0dp" app:strokeColor="@color/line" app:strokeWidth="1dp">
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="18dp">
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="现实任务" android:textColor="@color/blue" android:textSize="11sp" android:textStyle="bold" />
            <TextView android:id="@+id/text_mission_prompt" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:textColor="@color/text_primary" android:textSize="21sp" android:textStyle="bold" />
            <TextView android:id="@+id/text_mission_hint" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="7dp" android:text="选择你在这个场景里应该说的意大利语" android:textColor="@color/text_secondary" android:textSize="12sp" />
        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>
    <LinearLayout android:id="@+id/panel_mission_choices" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="10dp" android:orientation="vertical">
        <com.google.android.material.button.MaterialButton android:id="@+id/button_mission_a" style="@style/Widget.MaterialComponents.Button.OutlinedButton" android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="50dp" android:textAllCaps="false" />
        <com.google.android.material.button.MaterialButton android:id="@+id/button_mission_b" style="@style/Widget.MaterialComponents.Button.OutlinedButton" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="6dp" android:minHeight="50dp" android:textAllCaps="false" />
        <com.google.android.material.button.MaterialButton android:id="@+id/button_mission_c" style="@style/Widget.MaterialComponents.Button.OutlinedButton" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="6dp" android:minHeight="50dp" android:textAllCaps="false" />
        <com.google.android.material.button.MaterialButton android:id="@+id/button_mission_d" style="@style/Widget.MaterialComponents.Button.OutlinedButton" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="6dp" android:minHeight="50dp" android:textAllCaps="false" />
    </LinearLayout>
    <TextView android:id="@+id/text_mission_feedback" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="10dp" android:gravity="center" android:textSize="13sp" android:textStyle="bold" />
    <com.google.android.material.button.MaterialButton android:id="@+id/button_mission_next" android:layout_width="match_parent" android:layout_height="48dp" android:layout_marginTop="8dp" android:text="下一步 →" android:textAllCaps="false" android:visibility="gone" />
</LinearLayout>
