<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto" android:layout_width="match_parent" android:layout_height="match_parent" android:background="@color/bg" android:fillViewport="true">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="16dp">
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_vertical">
            <com.google.android.material.button.MaterialButton android:id="@+id/button_exam_back" style="@style/Widget.MaterialComponents.Button.TextButton" android:layout_width="wrap_content" android:layout_height="42dp" android:text="← 练习" />
            <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:gravity="center" android:text="A1 / A2 / B1 阶段自测" android:textColor="@color/text_primary" android:textSize="21sp" android:textStyle="bold" />
            <Space android:layout_width="68dp" android:layout_height="1dp" />
        </LinearLayout>
        <LinearLayout android:id="@+id/panel_exam_intro" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical">
            <TextView android:id="@+id/text_exam_history" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="10dp" android:background="@drawable/bg_soft_panel" android:padding="14dp" android:textColor="@color/text_secondary" android:textSize="13sp" android:lineSpacingExtra="2dp" />
            <com.google.android.material.button.MaterialButton android:id="@+id/button_exam_a1" android:layout_width="match_parent" android:layout_height="54dp" android:layout_marginTop="16dp" android:text="开始 A1 检查点 · 20题" android:textAllCaps="false" />
            <com.google.android.material.button.MaterialButton android:id="@+id/button_exam_a2" style="@style/Widget.MaterialComponents.Button.OutlinedButton" android:layout_width="match_parent" android:layout_height="54dp" android:layout_marginTop="8dp" android:text="开始 A2 检查点 · 20题" android:textAllCaps="false" />
            <com.google.android.material.button.MaterialButton android:id="@+id/button_exam_b1" style="@style/Widget.MaterialComponents.Button.OutlinedButton" android:layout_width="match_parent" android:layout_height="54dp" android:layout_marginTop="8dp" android:text="开始 B1 检查点 · 20题" android:textAllCaps="false" />
        </LinearLayout>
        <LinearLayout android:id="@+id/panel_exam_question" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:visibility="gone">
            <TextView android:id="@+id/text_exam_title" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="10dp" android:textColor="@color/text_primary" android:textSize="22sp" android:textStyle="bold" />
            <TextView android:id="@+id/text_exam_progress" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="3dp" android:textColor="@color/text_secondary" android:textSize="12sp" />
            <TextView android:id="@+id/text_exam_category" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="14dp" android:textColor="@color/blue" android:textSize="13sp" android:textStyle="bold" />
            <com.google.android.material.card.MaterialCardView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" app:cardBackgroundColor="@color/surface" app:cardCornerRadius="20dp" app:cardElevation="0dp" app:strokeColor="@color/line" app:strokeWidth="1dp">
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="18dp">
                    <TextView android:id="@+id/text_exam_question" android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center" android:minHeight="80dp" android:textColor="@color/text_primary" android:textSize="23sp" android:textStyle="bold" />
                    <com.google.android.material.button.MaterialButton android:id="@+id/button_exam_replay" style="@style/Widget.MaterialComponents.Button.OutlinedButton" android:layout_width="match_parent" android:layout_height="46dp" android:layout_marginTop="8dp" android:text="🔊 再听一次" android:visibility="gone" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>
            <LinearLayout android:id="@+id/panel_exam_choices" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical">
                <com.google.android.material.button.MaterialButton android:id="@+id/button_exam_c1" style="@style/Widget.MaterialComponents.Button.OutlinedButton" android:layout_width="match_parent" android:layout_height="54dp" android:layout_marginTop="12dp" android:textAllCaps="false" />
                <com.google.android.material.button.MaterialButton android:id="@+id/button_exam_c2" style="@style/Widget.MaterialComponents.Button.OutlinedButton" android:layout_width="match_parent" android:layout_height="54dp" android:layout_marginTop="7dp" android:textAllCaps="false" />
                <com.google.android.material.button.MaterialButton android:id="@+id/button_exam_c3" style="@style/Widget.MaterialComponents.Button.OutlinedButton" android:layout_width="match_parent" android:layout_height="54dp" android:layout_marginTop="7dp" android:textAllCaps="false" />
                <com.google.android.material.button.MaterialButton android:id="@+id/button_exam_c4" style="@style/Widget.MaterialComponents.Button.OutlinedButton" android:layout_width="match_parent" android:layout_height="54dp" android:layout_marginTop="7dp" android:textAllCaps="false" />
            </LinearLayout>
            <LinearLayout android:id="@+id/panel_exam_typing" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp" android:orientation="vertical" android:visibility="gone">
                <com.google.android.material.textfield.TextInputLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:hint="输入意大利语">
                    <com.google.android.material.textfield.TextInputEditText android:id="@+id/edit_exam_answer" android:layout_width="match_parent" android:layout_height="wrap_content" android:imeOptions="actionDone" android:inputType="text" android:maxLines="1" />
                </com.google.android.material.textfield.TextInputLayout>
                <com.google.android.material.button.MaterialButton android:id="@+id/button_exam_submit" android:layout_width="match_parent" android:layout_height="50dp" android:layout_marginTop="8dp" android:text="提交答案" />
            </LinearLayout>
            <TextView android:id="@+id/text_exam_feedback" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp" android:gravity="center" android:textSize="14sp" android:textStyle="bold" />
            <com.google.android.material.button.MaterialButton android:id="@+id/button_exam_next" android:layout_width="match_parent" android:layout_height="50dp" android:layout_marginTop="9dp" android:text="下一题 →" android:visibility="gone" />
        </LinearLayout>
        <LinearLayout android:id="@+id/panel_exam_result" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:visibility="gone">
            <TextView android:id="@+id/text_exam_result" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="16dp" android:background="@drawable/bg_soft_panel" android:padding="18dp" android:textColor="@color/text_primary" android:textSize="15sp" android:lineSpacingExtra="3dp" />
            <com.google.android.material.button.MaterialButton android:id="@+id/button_exam_restart" android:layout_width="match_parent" android:layout_height="50dp" android:layout_marginTop="10dp" android:text="返回阶段选择" />
        </LinearLayout>
    </LinearLayout>
</ScrollView>
