<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto" android:layout_width="match_parent" android:layout_height="match_parent" android:background="@color/bg">
 <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="16dp">
  <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="🌿 词族关联训练" android:textColor="@color/text_primary" android:textSize="26sp" android:textStyle="bold"/>
  <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="4dp" android:text="把变位、派生词和同根词连接起来记，不再一个词一个词孤立背。" android:textColor="@color/text_secondary"/>
  <com.google.android.material.card.MaterialCardView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="16dp" app:cardCornerRadius="20dp" app:cardElevation="0dp" app:strokeColor="@color/line" app:strokeWidth="1dp">
   <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="18dp">
    <TextView android:id="@+id/text_family_train_counter" android:layout_width="match_parent" android:layout_height="wrap_content" android:textColor="@color/blue" android:textStyle="bold"/>
    <TextView android:id="@+id/text_family_train_prompt" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="16dp" android:textColor="@color/text_primary" android:textSize="21sp" android:textStyle="bold"/>
    <com.google.android.material.button.MaterialButton android:id="@+id/button_family_train_1" style="@style/Widget.MaterialComponents.Button.OutlinedButton" android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="58dp" android:layout_marginTop="18dp" android:textAllCaps="false"/>
    <com.google.android.material.button.MaterialButton android:id="@+id/button_family_train_2" style="@style/Widget.MaterialComponents.Button.OutlinedButton" android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="58dp" android:layout_marginTop="8dp" android:textAllCaps="false"/>
    <com.google.android.material.button.MaterialButton android:id="@+id/button_family_train_3" style="@style/Widget.MaterialComponents.Button.OutlinedButton" android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="58dp" android:layout_marginTop="8dp" android:textAllCaps="false"/>
    <TextView android:id="@+id/text_family_train_feedback" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="14dp" android:background="@drawable/bg_soft_panel" android:padding="12dp" android:textColor="@color/text_primary" android:visibility="gone"/>
    <com.google.android.material.button.MaterialButton android:id="@+id/button_family_train_next" android:layout_width="match_parent" android:layout_height="48dp" android:layout_marginTop="12dp" android:text="下一题 →" android:textAllCaps="false" android:visibility="gone"/>
    <TextView android:id="@+id/text_family_train_summary" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="16dp" android:background="@drawable/bg_soft_panel" android:padding="14dp" android:textColor="@color/text_primary" android:textSize="16sp" android:visibility="gone"/>
   </LinearLayout>
  </com.google.android.material.card.MaterialCardView>
 </LinearLayout>
</ScrollView>
