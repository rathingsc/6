<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto" android:layout_width="match_parent" android:layout_height="match_parent" android:background="@color/bg" android:fillViewport="true">
 <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="16dp">
  <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="🎧 A1–B1 听力课程" android:textColor="@color/text_primary" android:textSize="25sp" android:textStyle="bold"/>
  <TextView android:id="@+id/text_lc_summary" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="5dp" android:textColor="@color/text_secondary" android:textSize="12sp"/>
  <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp" android:orientation="horizontal">
   <Spinner android:id="@+id/spinner_lc_level" android:layout_width="0dp" android:layout_height="48dp" android:layout_weight="1" android:background="@drawable/bg_search" android:paddingHorizontal="10dp"/>
   <Spinner android:id="@+id/spinner_lc_lesson" android:layout_width="0dp" android:layout_height="48dp" android:layout_marginStart="8dp" android:layout_weight="2" android:background="@drawable/bg_search" android:paddingHorizontal="10dp"/>
  </LinearLayout>
  <com.google.android.material.card.MaterialCardView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp" app:cardBackgroundColor="@color/surface" app:cardCornerRadius="20dp" app:cardElevation="0dp" app:strokeColor="@color/line" app:strokeWidth="1dp">
   <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="16dp">
    <TextView android:id="@+id/text_lc_step" android:layout_width="match_parent" android:layout_height="wrap_content" android:textColor="@color/blue" android:textSize="13sp" android:textStyle="bold"/>
    <TextView android:id="@+id/text_lc_source" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="6dp" android:textColor="@color/text_secondary" android:textSize="11sp"/>
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="10dp" android:orientation="horizontal">
     <com.google.android.material.button.MaterialButton android:id="@+id/button_lc_play" android:layout_width="0dp" android:layout_height="48dp" android:layout_weight="1" android:text="🔊 正常" android:textAllCaps="false"/>
     <com.google.android.material.button.MaterialButton android:id="@+id/button_lc_slow" style="@style/Widget.MaterialComponents.Button.OutlinedButton" android:layout_width="0dp" android:layout_height="48dp" android:layout_marginStart="8dp" android:layout_weight="1" android:text="🐢 慢速" android:textAllCaps="false"/>
    </LinearLayout>
    <TextView android:id="@+id/text_lc_it" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp" android:background="@drawable/bg_soft_panel" android:padding="12dp" android:textColor="@color/text_primary" android:textSize="18sp" android:textStyle="bold" android:visibility="gone"/>
    <TextView android:id="@+id/text_lc_zh" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="7dp" android:textColor="@color/text_secondary" android:textSize="13sp" android:visibility="gone"/>
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:orientation="horizontal">
     <com.google.android.material.button.MaterialButton android:id="@+id/button_lc_show_it" style="@style/Widget.MaterialComponents.Button.TextButton" android:layout_width="0dp" android:layout_height="42dp" android:layout_weight="1" android:text="看字幕" android:textAllCaps="false"/>
     <com.google.android.material.button.MaterialButton android:id="@+id/button_lc_show_zh" style="@style/Widget.MaterialComponents.Button.TextButton" android:layout_width="0dp" android:layout_height="42dp" android:layout_weight="1" android:text="看中文" android:textAllCaps="false"/>
    </LinearLayout>
    <EditText android:id="@+id/edit_lc_answer" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:background="@drawable/bg_search" android:hint="听写这句话" android:minHeight="54dp" android:padding="12dp" android:textColor="@color/text_primary" android:textColorHint="@color/text_secondary"/>
    <com.google.android.material.button.MaterialButton android:id="@+id/button_lc_check" android:layout_width="match_parent" android:layout_height="48dp" android:layout_marginTop="8dp" android:text="检查听写" android:textAllCaps="false"/>
    <TextView android:id="@+id/text_lc_feedback" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:lineSpacingExtra="3dp" android:textSize="12sp"/>
    <com.google.android.material.button.MaterialButton android:id="@+id/button_lc_next" android:layout_width="match_parent" android:layout_height="48dp" android:layout_marginTop="10dp" android:text="下一句 →" android:textAllCaps="false"/>
   </LinearLayout>
  </com.google.android.material.card.MaterialCardView>
 </LinearLayout>
</ScrollView>
