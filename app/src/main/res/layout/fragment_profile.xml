<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto" android:layout_width="match_parent" android:layout_height="match_parent" android:background="@color/bg" android:fillViewport="true">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="16dp" android:paddingBottom="28dp">
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="我的" android:textColor="@color/text_primary" android:textSize="28sp" android:textStyle="bold" />
        <com.google.android.material.card.MaterialCardView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="14dp" app:cardCornerRadius="20dp" app:cardElevation="0dp" app:strokeColor="@color/line" app:strokeWidth="1dp">
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="18dp">
                <TextView android:id="@+id/text_profile_stage" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="A0 入门" android:textColor="@color/blue" android:textSize="13sp" android:textStyle="bold" />
                <TextView android:id="@+id/text_profile_summary" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="5dp" android:text="连续学习 0 天 · ⭐ 0" android:textColor="@color/text_primary" android:textSize="20sp" android:textStyle="bold" />
                <TextView android:id="@+id/text_profile_detail" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="6dp" android:textColor="@color/text_secondary" android:textSize="13sp" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="18dp" android:text="常用" android:textColor="@color/text_primary" android:textStyle="bold" android:textSize="16sp" />
        <com.google.android.material.button.MaterialButton android:id="@+id/button_profile_vocabulary" style="@style/Widget.MaterialComponents.Button.OutlinedButton" android:layout_width="match_parent" android:layout_height="52dp" android:layout_marginTop="8dp" android:text="📚 我的词库" android:textAllCaps="false" />
        <com.google.android.material.button.MaterialButton android:id="@+id/button_profile_daily" style="@style/Widget.MaterialComponents.Button.OutlinedButton" android:layout_width="match_parent" android:layout_height="52dp" android:layout_marginTop="7dp" android:text="📅 今天学过什么" android:textAllCaps="false" />
        <com.google.android.material.button.MaterialButton android:id="@+id/button_profile_weekly" style="@style/Widget.MaterialComponents.Button.OutlinedButton" android:layout_width="match_parent" android:layout_height="52dp" android:layout_marginTop="7dp" android:text="📈 每周报告" android:textAllCaps="false" />
        <com.google.android.material.button.MaterialButton android:id="@+id/button_profile_passport" style="@style/Widget.MaterialComponents.Button.OutlinedButton" android:layout_width="match_parent" android:layout_height="52dp" android:layout_marginTop="7dp" android:text="🎯 能力护照与阶段闯关" android:textAllCaps="false" />
        <com.google.android.material.button.MaterialButton android:id="@+id/button_profile_forgetting" style="@style/Widget.MaterialComponents.Button.OutlinedButton" android:layout_width="match_parent" android:layout_height="52dp" android:layout_marginTop="7dp" android:text="🧠 个人遗忘画像" android:textAllCaps="false" />
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="18dp" android:text="设置与数据" android:textColor="@color/text_primary" android:textStyle="bold" android:textSize="16sp" />
        <com.google.android.material.button.MaterialButton android:id="@+id/button_profile_settings" style="@style/Widget.MaterialComponents.Button.OutlinedButton" android:layout_width="match_parent" android:layout_height="52dp" android:layout_marginTop="8dp" android:text="⚙ 学习设置" android:textAllCaps="false" />
        <com.google.android.material.button.MaterialButton android:id="@+id/button_profile_custom" style="@style/Widget.MaterialComponents.Button.OutlinedButton" android:layout_width="match_parent" android:layout_height="52dp" android:layout_marginTop="7dp" android:text="📝 自定义词句" android:textAllCaps="false" />
        <com.google.android.material.button.MaterialButton android:id="@+id/button_profile_database" style="@style/Widget.MaterialComponents.Button.OutlinedButton" android:layout_width="match_parent" android:layout_height="52dp" android:layout_marginTop="7dp" android:text="🛡 数据与备份" android:textAllCaps="false" />
    </LinearLayout>
</androidx.core.widget.NestedScrollView>
