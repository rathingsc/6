<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg"
    android:fillViewport="true"
    android:clipToPadding="false"
    android:paddingBottom="16dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingTop="10dp">

        <TextView
            android:id="@+id/text_completion_banner"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="16dp"
            android:layout_marginBottom="6dp"
            android:background="@drawable/bg_soft_panel"
            android:gravity="center"
            android:padding="10dp"
            android:text="✓ 完成一个学习节点"
            android:textColor="@color/success"
            android:textSize="13sp"
            android:textStyle="bold"
            android:visibility="gone" />

        <TextView
            android:id="@+id/text_resume_status"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="16dp"
            android:layout_marginBottom="6dp"
            android:background="@drawable/bg_soft_panel"
            android:padding="9dp"
            android:text="上次学习可以继续"
            android:textColor="@color/blue"
            android:textSize="12sp"
            android:visibility="gone" />

        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="14dp"
            app:cardBackgroundColor="@color/surface"
            app:cardCornerRadius="22dp"
            app:cardElevation="0dp"
            app:strokeColor="@color/line"
            app:strokeWidth="1dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_vertical" android:orientation="horizontal">
                    <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical">
                        <TextView android:id="@+id/text_greeting" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Buongiorno 👋" android:textColor="@color/text_primary" android:textSize="25sp" android:textStyle="bold" />
                        <TextView android:id="@+id/text_date" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="2dp" android:textColor="@color/text_secondary" android:textSize="12sp" />
                    </LinearLayout>
                    <TextView android:id="@+id/text_streak" android:layout_width="wrap_content" android:layout_height="wrap_content" android:background="@drawable/bg_soft_panel" android:paddingHorizontal="10dp" android:paddingVertical="7dp" android:text="🔥 0天" android:textColor="@color/amber" android:textSize="13sp" android:textStyle="bold" />
                </LinearLayout>

                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="14dp" android:orientation="horizontal">
                    <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:background="@drawable/bg_soft_panel" android:orientation="vertical" android:padding="11dp">
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="终学 Score" android:textColor="@color/text_secondary" android:textSize="11sp" android:textStyle="bold" />
                        <TextView android:id="@+id/text_score" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="2dp" android:text="0" android:textColor="@color/blue" android:textSize="24sp" android:textStyle="bold" />
                        <TextView android:id="@+id/text_score_stage" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textColor="@color/text_secondary" android:textSize="10sp" />
                    </LinearLayout>
                    <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_marginStart="8dp" android:layout_weight="1" android:background="@drawable/bg_soft_panel" android:orientation="vertical" android:padding="11dp">
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="今日路径" android:textColor="@color/text_secondary" android:textSize="11sp" android:textStyle="bold" />
                        <TextView android:id="@+id/text_path_count" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="2dp" android:text="0 / 0" android:textColor="@color/text_primary" android:textSize="21sp" android:textStyle="bold" />
                        <TextView android:id="@+id/text_weak_focus" android:layout_width="wrap_content" android:layout_height="wrap_content" android:ellipsize="end" android:maxLines="1" android:textColor="@color/text_secondary" android:textSize="10sp" />
                    </LinearLayout>
                </LinearLayout>

                <ProgressBar
                    android:id="@+id/progress_path"
                    style="?android:attr/progressBarStyleHorizontal"
                    android:layout_width="match_parent"
                    android:layout_height="8dp"
                    android:layout_marginTop="13dp"
                    android:max="100"
                    android:progressTint="@color/green" />

                <TextView android:id="@+id/text_next_title" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="13dp" android:text="下一步" android:textColor="@color/text_secondary" android:textSize="11sp" android:textStyle="bold" />
                <TextView android:id="@+id/text_next_task" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="3dp" android:textColor="@color/text_primary" android:textSize="17sp" android:textStyle="bold" />
                <TextView android:id="@+id/text_next_subtitle" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="3dp" android:textColor="@color/text_secondary" android:textSize="12sp" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/button_continue_path"
                    android:layout_width="match_parent"
                    android:layout_height="52dp"
                    android:layout_marginTop="12dp"
                    android:text="继续学习"
                    android:textAllCaps="false"
                    android:textSize="16sp"
                    android:textStyle="bold" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="14dp"
            android:layout_marginTop="10dp"
            app:cardBackgroundColor="@color/surface"
            app:cardCornerRadius="18dp"
            app:cardElevation="0dp"
            app:strokeColor="@color/line"
            app:strokeWidth="1dp">
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="14dp">
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">
                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="📘 今日单词"
                            android:textColor="@color/text_primary"
                            android:textSize="16sp"
                            android:textStyle="bold" />
                        <TextView
                            android:id="@+id/text_daily_words_summary"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="4dp"
                            android:text="按课程顺序加载每日单词"
                            android:textColor="@color/text_secondary"
                            android:textSize="12sp" />
                    </LinearLayout>
                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/button_daily_words"
                        style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                        android:layout_width="wrap_content"
                        android:layout_height="44dp"
                        android:layout_marginStart="10dp"
                        android:minWidth="96dp"
                        android:text="开始学习"
                        android:textAllCaps="false"
                        android:textSize="12sp" />
                </LinearLayout>
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="7dp"
                    android:text="固定每日词数和智能学习路径同时保留：这里按课程顺序学习；上面的“继续学习”按弱项与复习压力智能安排。"
                    android:textColor="@color/text_secondary"
                    android:textSize="10sp" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="14dp"
            android:layout_marginTop="8dp"
            app:cardBackgroundColor="@color/surface"
            app:cardCornerRadius="18dp"
            app:cardElevation="0dp"
            app:strokeColor="@color/line"
            app:strokeWidth="1dp">
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="14dp">
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_vertical" android:orientation="horizontal">
                    <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical">
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="🔄 今日复习" android:textColor="@color/text_primary" android:textSize="16sp" android:textStyle="bold" />
                        <TextView android:id="@+id/text_review_summary" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="4dp" android:text="正在计算到期复习…" android:textColor="@color/text_secondary" android:textSize="12sp" />
                    </LinearLayout>
                    <com.google.android.material.button.MaterialButton android:id="@+id/button_review_due" style="@style/Widget.MaterialComponents.Button.OutlinedButton" android:layout_width="wrap_content" android:layout_height="44dp" android:layout_marginStart="10dp" android:minWidth="96dp" android:text="开始复习" android:textAllCaps="false" android:textSize="12sp" />
                </LinearLayout>
                <com.google.android.material.button.MaterialButton android:id="@+id/button_daily_summary" style="@style/Widget.MaterialComponents.Button.TextButton" android:layout_width="match_parent" android:layout_height="40dp" android:layout_marginTop="4dp" android:text="查看今天学过什么 →" android:textAllCaps="false" android:textColor="@color/blue" android:textSize="11sp" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginHorizontal="16dp" android:layout_marginTop="13dp" android:gravity="center_vertical" android:orientation="horizontal">
            <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="今天学多久" android:textColor="@color/text_primary" android:textSize="14sp" android:textStyle="bold" />
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="每个节点约3–5分钟" android:textColor="@color/text_secondary" android:textSize="10sp" />
        </LinearLayout>

        <com.google.android.material.button.MaterialButtonToggleGroup
            android:id="@+id/group_time_budget"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="14dp"
            android:layout_marginTop="6dp"
            app:selectionRequired="true"
            app:singleSelection="true">
            <com.google.android.material.button.MaterialButton android:id="@+id/button_time_5" style="@style/Widget.MaterialComponents.Button.OutlinedButton" android:layout_width="0dp" android:layout_height="42dp" android:layout_weight="1" android:text="5分钟" android:textAllCaps="false" android:textSize="11sp" />
            <com.google.android.material.button.MaterialButton android:id="@+id/button_time_15" style="@style/Widget.MaterialComponents.Button.OutlinedButton" android:layout_width="0dp" android:layout_height="42dp" android:layout_weight="1" android:text="15分钟" android:textAllCaps="false" android:textSize="11sp" />
            <com.google.android.material.button.MaterialButton android:id="@+id/button_time_30" style="@style/Widget.MaterialComponents.Button.OutlinedButton" android:layout_width="0dp" android:layout_height="42dp" android:layout_weight="1" android:text="30分钟" android:textAllCaps="false" android:textSize="11sp" />
            <com.google.android.material.button.MaterialButton android:id="@+id/button_time_60" style="@style/Widget.MaterialComponents.Button.OutlinedButton" android:layout_width="0dp" android:layout_height="42dp" android:layout_weight="1" android:text="60分钟" android:textAllCaps="false" android:textSize="11sp" />
        </com.google.android.material.button.MaterialButtonToggleGroup>

        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginHorizontal="16dp" android:layout_marginTop="16dp" android:gravity="center_vertical" android:orientation="horizontal">
            <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="今日学习路径" android:textColor="@color/text_primary" android:textSize="17sp" android:textStyle="bold" />
            <TextView android:id="@+id/text_path_hint" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textColor="@color/text_secondary" android:textSize="10sp" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/path_container"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingTop="6dp" />

        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="14dp"
            android:layout_marginTop="12dp"
            app:cardBackgroundColor="@color/surface"
            app:cardCornerRadius="18dp"
            app:cardElevation="0dp"
            app:strokeColor="@color/line"
            app:strokeWidth="1dp">
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="14dp">
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="🏆 本周目标" android:textColor="@color/text_primary" android:textSize="14sp" android:textStyle="bold" />
                <TextView android:id="@+id/text_week_goal" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="6dp" android:textColor="@color/text_secondary" android:textSize="12sp" android:lineSpacingExtra="2dp" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginHorizontal="14dp" android:layout_marginTop="10dp" android:orientation="horizontal">
            <com.google.android.material.button.MaterialButton android:id="@+id/button_practice_hub" style="@style/Widget.MaterialComponents.Button.OutlinedButton" android:layout_width="0dp" android:layout_height="46dp" android:layout_weight="1" android:text="🎯 弱项练习" android:textAllCaps="false" android:textSize="12sp" />
            <com.google.android.material.button.MaterialButton android:id="@+id/button_emergency" style="@style/Widget.MaterialComponents.Button.OutlinedButton" android:layout_width="0dp" android:layout_height="46dp" android:layout_marginStart="8dp" android:layout_weight="1" android:text="🆘 救急意语" android:textAllCaps="false" android:textSize="12sp" />
        </LinearLayout>

        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginHorizontal="14dp" android:layout_marginTop="7dp" android:orientation="horizontal">
            <com.google.android.material.button.MaterialButton android:id="@+id/button_rescue" android:layout_width="0dp" android:layout_height="46dp" android:layout_weight="1" android:text="⚡ 5分钟抢救" android:textAllCaps="false" android:textSize="12sp" />
            <com.google.android.material.button.MaterialButton android:id="@+id/button_weekly_report" style="@style/Widget.MaterialComponents.Button.OutlinedButton" android:layout_width="0dp" android:layout_height="46dp" android:layout_marginStart="8dp" android:layout_weight="1" android:text="📊 本周报告" android:textAllCaps="false" android:textSize="12sp" />
        </LinearLayout>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="18dp"
            android:layout_marginTop="8dp"
            android:gravity="center"
            android:text="终学 Score 是 App 内部学习指标，不是官方 CEFR 成绩"
            android:textColor="@color/text_secondary"
            android:textSize="9sp" />
    </LinearLayout>
</androidx.core.widget.NestedScrollView>
