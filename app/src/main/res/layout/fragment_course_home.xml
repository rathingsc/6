<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent" android:layout_height="match_parent" android:background="@color/bg" android:fillViewport="true">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:paddingBottom="24dp">
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_vertical" android:paddingHorizontal="18dp" android:paddingTop="16dp" android:paddingBottom="8dp">
            <TextView android:id="@+id/text_course_streak" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="🔥 0天" android:textColor="@color/text_primary" android:textSize="15sp" android:textStyle="bold" />
            <TextView android:id="@+id/text_course_xp" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="⭐ 0" android:textColor="@color/amber" android:textSize="15sp" android:textStyle="bold" />
        </LinearLayout>
        <com.google.android.material.card.MaterialCardView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginHorizontal="14dp" android:layout_marginTop="4dp" app:cardCornerRadius="22dp" app:cardElevation="0dp" app:strokeColor="@color/line" app:strokeWidth="1dp">
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="18dp">
                <TextView android:id="@+id/text_course_stage" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="A0 入门" android:textColor="@color/blue" android:textSize="13sp" android:textStyle="bold" />
                <TextView android:id="@+id/text_course_unit_title" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="5dp" android:text="咖啡馆" android:textColor="@color/text_primary" android:textSize="25sp" android:textStyle="bold" />
                <TextView android:id="@+id/text_course_unit_subtitle" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="5dp" android:text="一步一步完成今天的课程" android:textColor="@color/text_secondary" android:textSize="13sp" />
                <ProgressBar android:id="@+id/progress_course_unit" style="?android:attr/progressBarStyleHorizontal" android:layout_width="match_parent" android:layout_height="8dp" android:layout_marginTop="14dp" android:max="100" android:progress="0" android:progressTint="@color/green" android:progressBackgroundTint="@color/line" />
                <TextView android:id="@+id/text_course_daily" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="10dp" android:text="今天约20分钟 · 只要继续往下学" android:textColor="@color/text_secondary" android:textSize="12sp" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>
        <com.google.android.material.card.MaterialCardView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginHorizontal="14dp" android:layout_marginTop="10dp" app:cardCornerRadius="18dp" app:cardElevation="0dp" app:strokeColor="@color/line" app:strokeWidth="1dp">
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="14dp">
                <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="🧠 智能背词" android:textColor="@color/text_primary" android:textSize="17sp" android:textStyle="bold" />
                <TextView android:id="@+id/text_smart_memory_summary" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="5dp" android:text="正在整理今天的复习与新词…" android:textColor="@color/text_secondary" android:textSize="12sp" android:lineSpacingExtra="2dp" />
                <com.google.android.material.button.MaterialButton android:id="@+id/button_smart_memory" style="@style/Widget.MaterialComponents.Button.OutlinedButton" android:layout_width="match_parent" android:layout_height="50dp" android:layout_marginTop="10dp" android:text="开始智能背词" android:textAllCaps="false" android:textSize="14sp" />
                <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="5dp" android:gravity="center" android:text="只用选：忘记了 / 有点模糊 / 记住了" android:textColor="@color/text_secondary" android:textSize="10sp" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center" android:paddingTop="16dp" android:text="学习路径" android:textColor="@color/text_secondary" android:textSize="12sp" android:textStyle="bold" />
        <LinearLayout android:id="@+id/container_course_path" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:paddingTop="4dp" android:paddingBottom="8dp" />
        <com.google.android.material.button.MaterialButton android:id="@+id/button_course_continue" android:layout_width="match_parent" android:layout_height="56dp" android:layout_marginHorizontal="18dp" android:layout_marginTop="8dp" android:text="继续学习" android:textAllCaps="false" android:textSize="16sp" />
        <TextView android:id="@+id/text_course_next_unit" android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center" android:paddingHorizontal="18dp" android:paddingTop="12dp" android:text="下一单元：基础交流" android:textColor="@color/text_secondary" android:textSize="12sp" />
    </LinearLayout>
</androidx.core.widget.NestedScrollView>
