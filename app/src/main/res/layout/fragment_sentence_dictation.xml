<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent" android:layout_height="match_parent" android:background="@color/bg" android:fillViewport="true">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="16dp">
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="✍️ 整句听写" android:textColor="@color/text_primary" android:textSize="27sp" android:textStyle="bold" />
        <TextView android:id="@+id/text_sd_stats" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="5dp" android:textColor="@color/text_secondary" android:textSize="13sp" />
        <com.google.android.material.card.MaterialCardView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="14dp" app:cardBackgroundColor="@color/surface" app:cardCornerRadius="22dp" app:cardElevation="0dp" app:strokeColor="@color/line" app:strokeWidth="1dp">
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="18dp">
                <TextView android:id="@+id/text_sd_source" android:layout_width="match_parent" android:layout_height="wrap_content" android:textColor="@color/blue" android:textSize="12sp" android:textStyle="bold" />
                <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="16dp" android:gravity="center" android:text="先听声音，不看答案" android:textColor="@color/text_primary" android:textSize="21sp" android:textStyle="bold" />
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="14dp" android:gravity="center" android:orientation="horizontal">
                    <com.google.android.material.button.MaterialButton android:id="@+id/button_sd_play" android:layout_width="0dp" android:layout_height="48dp" android:layout_weight="1" android:text="🔊 正常播放" android:textAllCaps="false" />
                    <com.google.android.material.button.MaterialButton android:id="@+id/button_sd_slow" style="@style/Widget.MaterialComponents.Button.OutlinedButton" android:layout_width="0dp" android:layout_height="48dp" android:layout_marginStart="8dp" android:layout_weight="1" android:text="🐢 慢速" android:textAllCaps="false" />
                </LinearLayout>
                <EditText android:id="@+id/edit_sd_answer" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="18dp" android:background="@drawable/bg_search" android:hint="输入你听到的完整意大利语句子" android:imeOptions="actionDone" android:inputType="textCapSentences|textMultiLine" android:minHeight="58dp" android:padding="13dp" android:textColor="@color/text_primary" android:textColorHint="@color/text_secondary" android:textSize="16sp" />
                <com.google.android.material.button.MaterialButton android:id="@+id/button_sd_submit" android:layout_width="match_parent" android:layout_height="50dp" android:layout_marginTop="12dp" android:text="检查答案" android:textAllCaps="false" android:textStyle="bold" />
                <LinearLayout android:id="@+id/panel_sd_feedback" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="15dp" android:background="@drawable/bg_soft_panel" android:orientation="vertical" android:padding="13dp" android:visibility="gone">
                    <TextView android:id="@+id/text_sd_score" android:layout_width="match_parent" android:layout_height="wrap_content" android:textColor="@color/text_primary" android:textSize="18sp" android:textStyle="bold" />
                    <TextView android:id="@+id/text_sd_cause" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="5dp" android:textColor="@color/error" android:textSize="13sp" android:textStyle="bold" />
                    <TextView android:id="@+id/text_sd_diff" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="7dp" android:textColor="@color/text_secondary" android:textIsSelectable="true" android:textSize="12sp" />
                    <TextView android:id="@+id/text_sd_answer" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="10dp" android:textColor="@color/text_primary" android:textSize="16sp" android:textStyle="bold" />
                    <TextView android:id="@+id/text_sd_zh" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="4dp" android:textColor="@color/text_secondary" android:textSize="13sp" />
                </LinearLayout>
                <com.google.android.material.button.MaterialButton android:id="@+id/button_sd_next" style="@style/Widget.MaterialComponents.Button.OutlinedButton" android:layout_width="match_parent" android:layout_height="48dp" android:layout_marginTop="12dp" android:text="下一句 →" android:textAllCaps="false" android:visibility="gone" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp" android:text="系统会区分漏词、拼写、冠词/阴阳性、词形/变位和词序问题；错误中的课程词会优先回到后续复习。" android:textColor="@color/text_secondary" android:textSize="12sp" />
    </LinearLayout>
</ScrollView>
