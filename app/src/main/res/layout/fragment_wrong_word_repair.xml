<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto" android:layout_width="match_parent" android:layout_height="match_parent" android:background="@color/bg" android:fillViewport="true">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="16dp">
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="错词重学" android:textColor="@color/text_primary" android:textSize="26sp" android:textStyle="bold" />
        <TextView android:id="@+id/text_repair_counter" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="4dp" android:textColor="@color/text_secondary" android:textSize="12sp" />
        <com.google.android.material.card.MaterialCardView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="14dp" app:cardCornerRadius="22dp" app:cardElevation="0dp" app:strokeColor="@color/line" app:strokeWidth="1dp">
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="20dp">
                <TextView android:id="@+id/text_repair_stage" android:layout_width="match_parent" android:layout_height="wrap_content" android:textColor="@color/blue" android:textSize="12sp" android:textStyle="bold" />
                <TextView android:id="@+id/text_repair_word" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="18dp" android:gravity="center" android:textColor="@color/text_primary" android:textSize="29sp" android:textStyle="bold" />
                <TextView android:id="@+id/text_repair_chinese" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="10dp" android:gravity="center" android:textColor="@color/text_primary" android:textSize="18sp" android:textStyle="bold" />
                <com.google.android.material.button.MaterialButton android:id="@+id/button_repair_audio" style="@style/Widget.MaterialComponents.Button.OutlinedButton" android:layout_width="match_parent" android:layout_height="46dp" android:layout_marginTop="14dp" android:text="🔊 播放发音" android:textAllCaps="false" />
                <EditText android:id="@+id/edit_repair_answer" android:layout_width="match_parent" android:layout_height="52dp" android:layout_marginTop="14dp" android:background="@drawable/bg_search" android:hint="输入意大利语" android:inputType="text" android:paddingHorizontal="14dp" android:singleLine="true" android:textColor="@color/text_primary" android:textColorHint="@color/text_secondary" android:visibility="gone" />
                <TextView android:id="@+id/text_repair_example" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="14dp" android:background="@drawable/bg_soft_panel" android:padding="12dp" android:lineSpacingExtra="3dp" android:textColor="@color/text_secondary" android:textSize="13sp" android:visibility="gone" />
                <TextView android:id="@+id/text_repair_feedback" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp" android:textColor="@color/text_secondary" android:textSize="13sp" />
                <com.google.android.material.button.MaterialButton android:id="@+id/button_repair_main" android:layout_width="match_parent" android:layout_height="52dp" android:layout_marginTop="16dp" android:text="显示释义" android:textAllCaps="false" />
                <com.google.android.material.button.MaterialButton android:id="@+id/button_repair_next" style="@style/Widget.MaterialComponents.Button.OutlinedButton" android:layout_width="match_parent" android:layout_height="48dp" android:layout_marginTop="8dp" android:text="下一个" android:textAllCaps="false" android:visibility="gone" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>
        <com.google.android.material.button.MaterialButton android:id="@+id/button_repair_back" style="@style/Widget.MaterialComponents.Button.TextButton" android:layout_width="match_parent" android:layout_height="48dp" android:layout_marginTop="10dp" android:text="返回练习中心" android:textAllCaps="false" />
    </LinearLayout>
</ScrollView>
