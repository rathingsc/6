<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto" android:layout_width="match_parent" android:layout_height="match_parent" android:background="@color/bg" android:fillViewport="true">
 <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="16dp">
  <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="🩺 个人错题诊断中心" android:textColor="@color/text_primary" android:textSize="26sp" android:textStyle="bold" />
  <TextView android:id="@+id/text_diag_overview" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="6dp" android:textColor="@color/text_secondary" android:textSize="13sp" />
  <com.google.android.material.card.MaterialCardView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="14dp" app:cardBackgroundColor="@color/surface" app:cardCornerRadius="20dp" app:cardElevation="0dp" app:strokeColor="@color/line" app:strokeWidth="1dp">
   <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="16dp">
    <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="当前最值得修复" android:textColor="@color/text_primary" android:textSize="16sp" android:textStyle="bold" />
    <TextView android:id="@+id/text_diag_priority" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="7dp" android:textColor="@color/blue" android:textSize="18sp" android:textStyle="bold" />
    <TextView android:id="@+id/text_diag_detail" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="6dp" android:textColor="@color/text_secondary" android:textSize="13sp" />
   </LinearLayout>
  </com.google.android.material.card.MaterialCardView>
  <com.google.android.material.card.MaterialCardView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="14dp" app:cardBackgroundColor="@color/surface" app:cardCornerRadius="18dp" app:cardElevation="0dp" app:strokeColor="@color/line" app:strokeWidth="1dp">
   <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="15dp">
    <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="错误原因画像" android:textColor="@color/text_primary" android:textSize="16sp" android:textStyle="bold" />
    <TextView android:id="@+id/text_diag_causes" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="7dp" android:textColor="@color/text_secondary" android:textSize="13sp" />
    <com.google.android.material.button.MaterialButton android:id="@+id/button_diag_sentence_dictation" style="@style/Widget.MaterialComponents.Button.OutlinedButton" android:layout_width="match_parent" android:layout_height="46dp" android:layout_marginTop="9dp" android:text="✍️ 用整句听写修复听力与拼写" android:textAllCaps="false" />
    <com.google.android.material.button.MaterialButton android:id="@+id/button_diag_error_evidence" style="@style/Widget.MaterialComponents.Button.OutlinedButton" android:layout_width="match_parent" android:layout_height="46dp" android:layout_marginTop="8dp" android:text="🧾 个人错句本" android:textAllCaps="false" />
   </LinearLayout>
  </com.google.android.material.card.MaterialCardView>
  <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="16dp" android:text="按错误类型修复" android:textColor="@color/text_primary" android:textSize="17sp" android:textStyle="bold" />
  <com.google.android.material.button.MaterialButton android:id="@+id/button_diag_wrong" android:layout_width="match_parent" android:layout_height="50dp" android:layout_marginTop="8dp" android:textAllCaps="false" />
  <com.google.android.material.button.MaterialButton android:id="@+id/button_diag_meaning" style="@style/Widget.MaterialComponents.Button.OutlinedButton" android:layout_width="match_parent" android:layout_height="50dp" android:layout_marginTop="7dp" android:textAllCaps="false" />
  <com.google.android.material.button.MaterialButton android:id="@+id/button_diag_listening" style="@style/Widget.MaterialComponents.Button.OutlinedButton" android:layout_width="match_parent" android:layout_height="50dp" android:layout_marginTop="7dp" android:textAllCaps="false" />
  <com.google.android.material.button.MaterialButton android:id="@+id/button_diag_spelling" style="@style/Widget.MaterialComponents.Button.OutlinedButton" android:layout_width="match_parent" android:layout_height="50dp" android:layout_marginTop="7dp" android:textAllCaps="false" />
  <com.google.android.material.button.MaterialButton android:id="@+id/button_diag_speaking" style="@style/Widget.MaterialComponents.Button.OutlinedButton" android:layout_width="match_parent" android:layout_height="50dp" android:layout_marginTop="7dp" android:textAllCaps="false" />
  <com.google.android.material.button.MaterialButton android:id="@+id/button_diag_grammar" style="@style/Widget.MaterialComponents.Button.OutlinedButton" android:layout_width="match_parent" android:layout_height="50dp" android:layout_marginTop="7dp" android:text="🧠 打开语法弱点诊断" android:textAllCaps="false" />
  <com.google.android.material.card.MaterialCardView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="15dp" app:cardBackgroundColor="@color/surface" app:cardCornerRadius="18dp" app:cardElevation="0dp" app:strokeColor="@color/line" app:strokeWidth="1dp">
   <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="15dp">
    <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="最常错的词" android:textColor="@color/text_primary" android:textSize="16sp" android:textStyle="bold" />
    <TextView android:id="@+id/text_diag_top_wrong" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="7dp" android:textColor="@color/text_secondary" android:textSize="14sp" />
   </LinearLayout>
  </com.google.android.material.card.MaterialCardView>
 </LinearLayout>
</ScrollView>
