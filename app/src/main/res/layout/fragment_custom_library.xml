<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto" android:layout_width="match_parent" android:layout_height="match_parent" android:background="@color/bg" android:orientation="vertical">
 <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="16dp">
  <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="⭐ 我的单词与句子" android:textColor="@color/text_primary" android:textSize="26sp" android:textStyle="bold" />
  <TextView android:id="@+id/text_custom_stats" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="5dp" android:textColor="@color/text_secondary" android:textSize="13sp" />
  <com.google.android.material.card.MaterialCardView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp" app:cardBackgroundColor="@color/surface" app:cardCornerRadius="18dp" app:cardElevation="0dp" app:strokeColor="@color/line" app:strokeWidth="1dp">
   <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="14dp">
    <Spinner android:id="@+id/spinner_custom_kind" android:layout_width="match_parent" android:layout_height="44dp" />
    <EditText android:id="@+id/edit_custom_it" android:layout_width="match_parent" android:layout_height="48dp" android:hint="意大利语单词或句子" android:inputType="text" android:maxLines="2" />
    <EditText android:id="@+id/edit_custom_zh" android:layout_width="match_parent" android:layout_height="48dp" android:hint="中文释义" android:inputType="text" android:maxLines="2" />
    <EditText android:id="@+id/edit_custom_note" android:layout_width="match_parent" android:layout_height="48dp" android:hint="备注（可选）" android:inputType="text" android:maxLines="2" />
    <com.google.android.material.button.MaterialButton android:id="@+id/button_add_custom" android:layout_width="match_parent" android:layout_height="46dp" android:layout_marginTop="8dp" android:text="加入个人学习库" />
   </LinearLayout>
  </com.google.android.material.card.MaterialCardView>
  <CheckBox android:id="@+id/check_custom_due" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="6dp" android:text="只看今天到期" />
 </LinearLayout>
 <androidx.recyclerview.widget.RecyclerView android:id="@+id/recycler_custom" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:clipToPadding="false" android:paddingBottom="16dp" />
</LinearLayout>
