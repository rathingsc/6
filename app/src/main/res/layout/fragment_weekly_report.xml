<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto" android:layout_width="match_parent" android:layout_height="match_parent" android:background="@color/bg">
 <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="16dp">
  <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="📊 本周学习报告" android:textColor="@color/text_primary" android:textSize="26sp" android:textStyle="bold"/>
  <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="4dp" android:text="不是只看数字，而是告诉你下周应该怎么调整。学习时长为本地行为数据估算值。" android:textColor="@color/text_secondary"/>
  <com.google.android.material.card.MaterialCardView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="14dp" app:cardCornerRadius="18dp" app:cardElevation="0dp" app:strokeColor="@color/line" app:strokeWidth="1dp"><TextView android:id="@+id/text_week_report_main" android:layout_width="match_parent" android:layout_height="wrap_content" android:padding="16dp" android:textColor="@color/text_primary" android:textSize="16sp"/></com.google.android.material.card.MaterialCardView>
  <com.google.android.material.card.MaterialCardView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="10dp" app:cardCornerRadius="18dp" app:cardElevation="0dp" app:strokeColor="@color/line" app:strokeWidth="1dp"><TextView android:id="@+id/text_week_report_memory" android:layout_width="match_parent" android:layout_height="wrap_content" android:padding="16dp" android:textColor="@color/text_primary" android:textSize="15sp"/></com.google.android.material.card.MaterialCardView>
  <com.google.android.material.card.MaterialCardView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="10dp" app:cardCornerRadius="18dp" app:cardElevation="0dp" app:strokeColor="@color/line" app:strokeWidth="1dp"><TextView android:id="@+id/text_week_report_weak" android:layout_width="match_parent" android:layout_height="wrap_content" android:padding="16dp" android:textColor="@color/text_primary" android:textSize="15sp"/></com.google.android.material.card.MaterialCardView>
  <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="16dp" android:text="下周建议" android:textColor="@color/text_primary" android:textSize="18sp" android:textStyle="bold"/>
  <TextView android:id="@+id/text_week_report_advice" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:background="@drawable/bg_soft_panel" android:padding="14dp" android:textColor="@color/text_primary" android:textSize="15sp"/>
  <com.google.android.material.button.MaterialButton android:id="@+id/button_week_rescue" android:layout_width="match_parent" android:layout_height="50dp" android:layout_marginTop="16dp" android:text="⚡ 现在做5分钟抢救" android:textAllCaps="false"/>
  <com.google.android.material.button.MaterialButton android:id="@+id/button_week_practice" style="@style/Widget.MaterialComponents.Button.OutlinedButton" android:layout_width="match_parent" android:layout_height="48dp" android:layout_marginTop="8dp" android:text="进入专项练习中心" android:textAllCaps="false"/>
 </LinearLayout>
</ScrollView>
