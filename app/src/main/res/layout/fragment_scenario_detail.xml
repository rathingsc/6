<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical" android:background="@color/bg" android:paddingTop="10dp">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_vertical" android:paddingHorizontal="12dp">
        <com.google.android.material.button.MaterialButton android:id="@+id/button_scenario_detail_back" style="@style/Widget.MaterialComponents.Button.TextButton" android:layout_width="wrap_content" android:layout_height="44dp" android:text="← 场景" />
        <TextView android:id="@+id/text_scenario_detail_title" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:gravity="center" android:textColor="@color/text_primary" android:textSize="21sp" android:textStyle="bold" />
        <Space android:layout_width="70dp" android:layout_height="1dp" />
    </LinearLayout>
    <TextView android:id="@+id/text_scenario_detail_subtitle" android:layout_width="match_parent" android:layout_height="wrap_content" android:paddingHorizontal="18dp" android:paddingVertical="7dp" android:textColor="@color/text_secondary" android:textSize="13sp" />
    <com.google.android.material.button.MaterialButton android:id="@+id/button_scenario_mission" android:layout_width="match_parent" android:layout_height="48dp" android:layout_marginHorizontal="18dp" android:layout_marginBottom="7dp" android:text="🎭 开始真实场景任务" android:textAllCaps="false" />
    <com.google.android.material.button.MaterialButton android:id="@+id/button_scenario_dialogue" android:layout_width="match_parent" android:layout_height="48dp" android:layout_marginHorizontal="18dp" android:layout_marginBottom="8dp" android:text="💬 练这个场景的对话" />
    <androidx.recyclerview.widget.RecyclerView android:id="@+id/recycler_scenario_phrases" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:clipToPadding="false" android:paddingBottom="18dp" />
</LinearLayout>
