<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginHorizontal="14dp" android:layout_marginVertical="6dp" app:cardBackgroundColor="@color/surface" app:cardCornerRadius="18dp" app:cardElevation="0dp" app:strokeColor="@color/line" app:strokeWidth="1dp">
 <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="15dp">
  <TextView android:id="@+id/text_emergency_category" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textColor="@color/error" android:textSize="11sp" android:textStyle="bold" />
  <TextView android:id="@+id/text_emergency_it" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="5dp" android:textColor="@color/text_primary" android:textSize="20sp" android:textStyle="bold" />
  <TextView android:id="@+id/text_emergency_zh" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="4dp" android:textColor="@color/text_secondary" android:textSize="14sp" />
  <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="9dp" android:orientation="horizontal">
   <com.google.android.material.button.MaterialButton android:id="@+id/button_emergency_speak" style="@style/Widget.MaterialComponents.Button.OutlinedButton" android:layout_width="0dp" android:layout_height="42dp" android:layout_weight="1" android:text="🔊 大声播放" />
   <com.google.android.material.button.MaterialButton android:id="@+id/button_emergency_save" android:layout_width="0dp" android:layout_height="42dp" android:layout_marginStart="7dp" android:layout_weight="1" android:text="⭐ 收藏句子" />
  </LinearLayout>
 </LinearLayout>
</com.google.android.material.card.MaterialCardView>
