<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginHorizontal="16dp" android:layout_marginVertical="5dp" app:cardCornerRadius="18dp" app:cardElevation="0dp" app:strokeColor="@color/line" app:strokeWidth="1dp">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical" android:padding="14dp">
        <TextView android:id="@+id/text_life_task_emoji" android:layout_width="48dp" android:layout_height="48dp" android:gravity="center" android:text="☕" android:textSize="27sp" />
        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical" android:paddingStart="8dp">
            <TextView android:id="@+id/text_life_task_title" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="咖啡店点单" android:textColor="@color/text_primary" android:textSize="16sp" android:textStyle="bold" />
            <TextView android:id="@+id/text_life_task_subtitle" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="3dp" android:text="点单、付款、小票" android:textColor="@color/text_secondary" android:textSize="12sp" />
            <TextView android:id="@+id/text_life_task_score" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="6dp" android:text="基础 0% · 独立 0% · 实战 0%" android:textColor="@color/text_secondary" android:textSize="11sp" />
            <TextView android:id="@+id/text_life_task_status" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="3dp" android:text="下一关 · 基础应对" android:textColor="@color/blue" android:textSize="12sp" android:textStyle="bold" />
        </LinearLayout>
        <TextView android:layout_width="28dp" android:layout_height="wrap_content" android:gravity="center" android:text="›" android:textColor="@color/text_secondary" android:textSize="26sp" />
    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
