# Copy this file to keystore.properties ONLY for a local signed release build.
# keystore.properties is ignored by Git.
# The storeFile must point to the SAME permanent zhongxue_release.jks used by Codemagic.
storeFile=/absolute/path/to/zhongxue_release.jks
storePassword=YOUR_PRIVATE_KEYSTORE_PASSWORD
keyAlias=zhongxue
keyPassword=YOUR_PRIVATE_KEY_PASSWORD
